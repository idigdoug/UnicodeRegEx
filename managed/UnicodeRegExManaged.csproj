<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <WarningLevel>4</WarningLevel>
    <BaseOutputPath>..\out\out\</BaseOutputPath>

    <AssemblyName>UnicodeRegEx</AssemblyName>
    <AssemblyTitle>UnicodeRegEx</AssemblyTitle>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>

  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\lib\UnicodeRegExLib.vcxproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <Reference Include="UnicodeRegEx.Interop">
      <HintPath>..\out\UnicodeRegEx.Interop.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
